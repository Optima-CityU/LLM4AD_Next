
# 建议留空使用相对路径，Vite proxy 或 Nginx 代理进行处理
VITE_API_URL=""

# 本地开发API代理，如 http://localhost:8000 http://192.168.1.100:8000
VITE_PROXY_TARGET=http://localhost:8000

# Code Server地址，默认为/code_ide，本地开发可改为code-server-proxy服务如http://localhost:8083
VITE_CODE_SERVER_URL=/code_ide

# Plausible 浏览统计。domain 必须与 Plausible 后台站点配置一致；留空则不启用。
VITE_PLAUSIBLE_ENABLED=true
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_ENDPOINT=https://plausible.dadastory.com/api/event
# 关闭自动 pageview 后，由 TanStack Router 在路由解析完成时上报并携带 path/route_id/title/search/hash。
VITE_PLAUSIBLE_AUTO_CAPTURE_PAGEVIEWS=false
VITE_PLAUSIBLE_HASH_BASED_ROUTING=false
VITE_PLAUSIBLE_OUTBOUND_LINKS=false
VITE_PLAUSIBLE_FILE_DOWNLOADS=false
VITE_PLAUSIBLE_FORM_SUBMISSIONS=false
VITE_PLAUSIBLE_CAPTURE_ON_LOCALHOST=false
VITE_PLAUSIBLE_LOGGING=true
VITE_PLAUSIBLE_BIND_TO_WINDOW=true

# 管理员访客统计 iframe 地址。填 Plausible 公开分享链接或其他允许 iframe 嵌入的公开统计页。
# 留空时不会显示嵌入内容。
VITE_ADMIN_ANALYTICS_URL=

MAILCATCHER_HOST=http://localhost:1080
