# Work directory from the build instructions, kept separate from gateway state.
FILAMENT_WORK_DIR=
FILAMENT_DEVICE=
FILAMENT_ADB_PORT=5037
FILAMENT_STATE_DIR=./state
FILAMENT_GATEWAY_UID=1000
FILAMENT_GATEWAY_GID=1000
# Set llm4ad-filament-gateway on an AppArmor host with restricted user namespaces.
FILAMENT_APPARMOR_PROFILE=unconfined
LLM4AD_SERVER_URL=https://llm4ad-next.cn
LLM4AD_GATEWAY_NAME=filament-fsr1
LLM4AD_ALLOWED_USER_IDS=
LLM4AD_GATEWAY_UI=true
LLM4AD_GATEWAY_UI_HOST=127.0.0.1
LLM4AD_GATEWAY_UI_PORT=8768
