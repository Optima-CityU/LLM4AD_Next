+// ── phonefarm 确定性跑法 ────────────────────────────────────────────────────
+// 把 Sponza 从「交互式 demo」改成「确定性负载」: 相机走固定轨迹, 渲满固定帧数自退,
+// 进渲染循环前落 started 标记, 退出前写 ground-truth JSON。
+// 契约见 phonefarm loop_v1/carriers/anki-sponza/contract/launch.json。
+//
+// 纪律 (和 refbench 一致):
+//  * 相机姿态是 frame_index 的**纯函数** —— 不用 elapsedTime。墙钟会让每轮轨迹不同,
+//    那样两臂就不可比了。
+//  * 进度信号走文件系统, 不走 logcat (测试机上 logcat 会整个哑掉)。
+//  * JSON 里只写 ground truth, 不写帧率/分位数/任何统计量 —— 测量归 loop_v1。
+//
+// ⚠ 未接的部分: intent extras 还没接进来 (Android 走 NativeActivity, argc/argv 是空的,
+//   要用 JNI 从 g_androidApp->activity 取 getIntent().getStringExtra(), 再灌进 CVarSet)。
+//   在那之前这里用下面这组默认值。
+namespace {
+
+constexpr U32 kDefaultFrames = 3600u; // 渲满多少帧后自退
+
+#if ANKI_OS_ANDROID
+constexpr const Char* kFilesDir = "/storage/emulated/0/Android/data/org.anki.Sponza/files";
+#else
+constexpr const Char* kFilesDir = ".";
+#endif
+
+// 固定轨迹: 绕 Sponza 中庭匀速环绕一圈, 纯 frame_index 的函数。
+void setDeterministicCamera(SceneNode& cam, U32 frameIdx, U32 totalFrames)
+{
+	constexpr F32 kRadius = 12.0f;
+	constexpr F32 kHeight = 3.0f;
+	const F32 t = F32(frameIdx) / F32(totalFrames); // [0, 1)
+	const F32 angle = t * 2.0f * kPi;
+
+	cam.setLocalOrigin(Vec3(kRadius * cos(angle), kHeight, kRadius * sin(angle)));
+	cam.lookAtPoint(Vec4(0.0f, kHeight, 0.0f, 0.0f));
+}
+
+void writeMarker(const Char* name, const Char* contents)
+{
+	Char path[512];
+	snprintf(path, sizeof(path), "%s/%s", kFilesDir, name);
+	FILE* f = fopen(path, "w");
+	if(f)
+	{
+		fputs(contents, f);
+		fflush(f);
+		fsync(fileno(f)); // harness 靠这个文件判起跑/收尾, 必须真落盘
+		fclose(f);
+	}
+}
+
+} // anonymous namespace
+
 class MyApp : public SampleApp
