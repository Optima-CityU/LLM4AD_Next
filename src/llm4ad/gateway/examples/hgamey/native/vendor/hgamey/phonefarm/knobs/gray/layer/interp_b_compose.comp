#version 450
// 路线 B 第 5 步: 合成输出。重新按运动场反向采样两帧取平均 (不另存全分辨率预对齐缓冲, 重算比读写 float 缓冲便宜),
// 加上 NPU 输出的残差 (int8 NHWC 3 通道, 分辨率 rw x rh, 解量化后双线性放大、乘 255), 取整写进 rgba8 输出;
// HUD 框内直接取离目标时刻更近的一帧。与 I1 convert_anvil.py 半分辨率评估的 fb + resize(r)*255 一致。
// 调度: x = ceil(W/8), y = ceil(H/8)。
#define FLOW_BINDING 2
#define HUD_BINDING 5
#include "interp_common.glsl"
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D f0;
layout(binding = 1) uniform sampler2D f1;
layout(std430, binding = 3) readonly buffer Res { uint d[]; } res;   // rh*rw*3 int8, 按 4 字节打包
layout(binding = 4, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P {
    int W; int H; int gw; int gh; float cell; int rw; int rh;
    float t; float res_scale; float res_zp; int hud_on;
} pc;

float res_at(int x, int y, int c) {
    uint i = uint((y * pc.rw + x) * 3 + c);
    return (int8_at(res.d[i >> 2u], i) - pc.res_zp) * pc.res_scale;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.W || p.y >= pc.H) return;
    ivec2 full = ivec2(pc.W, pc.H);
    vec3 outc;
    if (pc.hud_on != 0 && in_hud(p)) {
        outc = (pc.t < 0.5 ? texelFetch(f0, p, 0).rgb : texelFetch(f1, p, 0).rgb) * 255.0;
    } else {
        vec2 pf = vec2(p);
        vec2 v = flow_at(pf, pc.gw, pc.gh, pc.cell);
        vec3 a = warp255(f0, pf - pc.t * v, full);
        vec3 b = warp255(f1, pf + (1.0 - pc.t) * v, full);
        int x0, x1, y0, y1; float ax, ay;
        up_coord(p.x, pc.W, pc.rw, x0, x1, ax);
        up_coord(p.y, pc.H, pc.rh, y0, y1, ay);
        vec3 r;
        for (int c = 0; c < 3; c++) {
            float top = res_at(x0, y0, c) * (1.0 - ax) + res_at(x1, y0, c) * ax;
            float bot = res_at(x0, y1, c) * (1.0 - ax) + res_at(x1, y1, c) * ax;
            r[c] = top * (1.0 - ay) + bot * ay;
        }
        outc = (a + b) * 0.5 + r * 255.0;
    }
    vec3 q = clamp(floor(outc + 0.5), 0.0, 255.0);
    imageStore(dst, p, vec4(q / 255.0, 1.0));
}
