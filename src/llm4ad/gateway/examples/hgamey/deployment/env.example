# Native components use this case's source unless a verified native image is reused.
RUST_IMAGE=rust:1.99-slim-bookworm
PYTHON_IMAGE=python:3.13.16-slim-bookworm
# Optional verified native image; default uses this Dockerfile's source-built stage.
HGAMEY_NATIVE_IMAGE=native-runtime
APT_MIRROR=
CARGO_REGISTRY_MIRROR=
ANDROID_REPOSITORY_BASE=https://dl.google.com/android/repository
TRACE_PROCESSOR_URL=
LLM4AD_PACKAGE=llm4ad-next
PIP_INDEX_URL=https://pypi.org/simple
LLM4AD_SERVER_URL=https://llm4ad-next.cn
LLM4AD_GATEWAY_NAME=genshin-phone
LLM4AD_ALLOWED_USER_IDS=
LLM4AD_GATEWAY_ADAPTER=hgamey
# Retain private execution logs for seven days, independently of uploaded evidence.
LLM4AD_GATEWAY_LOG_KEEP_SECONDS=604800
# Dashboard is enabled by default; false selects headless startup.
LLM4AD_GATEWAY_UI=true
# Host networking: these are the actual host listener address and port.
LLM4AD_GATEWAY_UI_HOST=127.0.0.1
LLM4AD_GATEWAY_UI_PORT=8768
# Optional independent dashboard password, passed only at runtime.
# LLM4AD_GATEWAY_UI_PASSWORD=
HGAMEY_DEVICES_JSON=[{"id":"phone-a","host":"192.168.1.101","port":5555,"expected_serial":"SERIAL","device_profile":"GPU-driver-Android-version"}]
HGAMEY_REFERENCE_PATH=/inputs/genshin
HGAMEY_STARTUP_CHECK=true
HGAMEY_GAME_CHECK_CONFIG=/config/game-check.json
ADB_BIN=/usr/bin/adb
ANDROID_ADB_SERVER_PORT=5039
# Host directories must be writable by UID 1000 where state is stored.
HGAMEY_DATA_DIR=./data
HGAMEY_INPUTS_DIR=./inputs
HGAMEY_CONFIG_DIR=./config
HGAMEY_PHONEFARM_DIR=./phonefarm-state
ADB_IDENTITY_FILE=./adbkey
ADB_STATE_DIR=./adb-state
