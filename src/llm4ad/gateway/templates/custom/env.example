LLM4AD_SERVER_URL={{SERVER}}
LLM4AD_GATEWAY_NAME={{NAME}}
LLM4AD_ALLOWED_USER_IDS={{USERS}}
LLM4AD_EVALUATOR=/evaluator/evaluator.py:Evaluator
LLM4AD_GATEWAY_CONCURRENCY=1
# Retain private execution logs for seven days, independently of uploaded evidence.
LLM4AD_GATEWAY_LOG_KEEP_SECONDS=604800
# Dashboard is enabled by default; false selects headless startup.
LLM4AD_GATEWAY_UI=true
# Published host address and port; the bridge container listens on 0.0.0.0:8768.
LLM4AD_GATEWAY_UI_HOST=127.0.0.1
LLM4AD_GATEWAY_UI_PORT=8768
# Pin the SDK to the platform-compatible release. A wheel in wheels/ takes priority.
LLM4AD_PACKAGE=llm4ad-next=={{SDK_VERSION}}
# Optional build-time package mirror.
PIP_INDEX_URL=https://pypi.org/simple
# Optional independent dashboard password, passed only at runtime.
# LLM4AD_GATEWAY_UI_PASSWORD=
