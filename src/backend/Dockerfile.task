# ============================================================
# LLM4AD 任务执行容器镜像
# ============================================================
# 一镜多入口：同一镜像按 ContainerJobSpec.command 覆盖 CMD 分别承载
#   - 任务执行     app/tasks/container_runner.py（默认 CMD）
#   - 调参执行     app/tasks/chat_tune_runner.py
#   - 研究 pipeline app/tasks/research_container_runner.py（需 research extra）
#   - 研究协作     app/tasks/research_collab_container_runner.py（需 research extra）
# 故装 research extra（researchclaw，公开 git 依赖；git 由 bookworm 基础镜像自带）。

# ---------- 知识文档解析协议代理 ----------
ARG CC_SWITCH_DOWNLOAD_IMAGE=docker.1ms.run/curlimages/curl:8.16.0
# cc-switch 在每个知识解析容器内独立运行，将 Anthropic Messages 转换为平台
# 已支持的 OpenAI Chat Completions 协议。固定版本并校验归档，避免 latest 漂移。
FROM ${CC_SWITCH_DOWNLOAD_IMAGE} AS cc-switch-runtime

USER root
ARG TARGETARCH=amd64
ARG CC_SWITCH_VERSION=5.10.1
ARG CC_SWITCH_RELEASE_BASE=https://gh-proxy.org/https://github.com/SaladDay/cc-switch-cli/releases/download
RUN case "${TARGETARCH}" in \
      amd64) CC_SWITCH_ARCH=x64; CC_SWITCH_SHA256=be6836eb42cf6747b3830b15d87902fc6a1331c35263aa7590ed0a37a4430790 ;; \
      arm64) CC_SWITCH_ARCH=arm64; CC_SWITCH_SHA256=10277f9e7aa76125ab4035e08ac15a52bc43d2c485f677b5ffec2055436d59e5 ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && CC_SWITCH_ARCHIVE="cc-switch-cli-v${CC_SWITCH_VERSION}-linux-${CC_SWITCH_ARCH}-musl.tar.gz" \
    && curl -fL --retry 3 \
      "${CC_SWITCH_RELEASE_BASE}/v${CC_SWITCH_VERSION}/${CC_SWITCH_ARCHIVE}" \
      -o /tmp/cc-switch.tar.gz \
    && echo "${CC_SWITCH_SHA256}  /tmp/cc-switch.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/cc-switch.tar.gz -C /tmp \
    && install -m 0755 /tmp/cc-switch /usr/local/bin/cc-switch

# ---------- 基础镜像 ----------
FROM python:3.12-bookworm

# 禁用 Python 输出缓冲，保证日志实时输出
ENV PYTHONUNBUFFERED=1

# ---------- 安装 C++ 和 Java 编译环境 ----------
ARG APT_MIRROR=""
RUN if [ -n "$APT_MIRROR" ]; then \
      sed -i "s@deb.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources && \
      sed -i "s@security.debian.org@${APT_MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    pkg-config \
    libeigen3-dev \
    openjdk-17-jdk-headless \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ---------- 安装 TeX Live（仅 AutoResearch 论文阶段用）----------
# ARC 的 compile_latex() 走 pdflatex → bibtex → pdflatex×2 三遍编译；缺 pdflatex
# 时 ARC 降级为只导出 .tex（不报错、无 PDF）。约 +1GB 镜像体积，运行时内存不受影响。
# 演化任务不用 LaTeX，但研究镜像复用本镜像（RESEARCH_RUNNER_IMAGE），故装在此处。
RUN apt-get update && apt-get install -y --no-install-recommends \
    texlive-latex-base \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    texlive-bibtex-extra \
    texlive-science \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="$JAVA_HOME/bin:$PATH"

# ---------- 安装 uv 包管理器 ----------
COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

# 预编译字节码，加快启动速度
ENV UV_COMPILE_BYTECODE=1
# 使用 copy 模式安装依赖，避免硬链接问题
ENV UV_LINK_MODE=copy

# ---------- 工作目录 ----------
WORKDIR /app/backend/

# 将虚拟环境加入 PATH
ENV PATH="/app/backend/.venv/bin:$PATH"

# ---------- 安装依赖（含 research extra，不含工作区包，利用 Docker 层缓存）----------
ARG UV_INDEX_URL
COPY src/backend/uv.lock uv.lock
RUN --mount=type=cache,id=uv-task-runner,target=/root/.cache/uv \
    --mount=type=bind,source=src/backend/pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=pyproject.toml,target=/pyproject.toml \
    --mount=type=bind,source=README.md,target=/README.md \
    uv sync --no-install-workspace --extra research

# ---------- 复制应用代码 ----------
# 仅 uv sync（editable 安装工作区）所需：pyproject + 包标记 + llm4ad 源。
# 高频改动的入口脚本延后到 uv sync 之后再 COPY，避免改脚本触发工作区重装。
COPY ./src/backend/pyproject.toml /app/backend/
COPY ./src/backend/app/__init__.py        /app/backend/app/__init__.py

# 复制 llm4ad 核心库及根项目配置
COPY ./src/llm4ad             /src/llm4ad
COPY ./examples               /examples
COPY ./pyproject.toml     /pyproject.toml
COPY ./README.md          /README.md

# ---------- 安装工作区包（含 research extra）----------
RUN --mount=type=cache,id=uv-task-runner,target=/root/.cache/uv \
    --mount=type=bind,source=src/backend/pyproject.toml,target=pyproject.toml \
    uv sync --extra research

# Python Claude Agent SDK 由 uv 安装并自带 Claude Code CLI，无需额外 Node 运行时。
COPY --from=cc-switch-runtime /usr/local/bin/cc-switch /usr/local/bin/cc-switch

# ---------- 复制容器入口脚本（editable 安装无需其内容，故放最后：改脚本只失效本层，不重跑 uv sync）----------
COPY ./src/backend/app/tasks/container_runner.py             /app/backend/app/tasks/container_runner.py
COPY ./src/backend/app/tasks/chat_tune_runner.py             /app/backend/app/tasks/chat_tune_runner.py
COPY ./src/backend/app/tasks/research_container_runner.py    /app/backend/app/tasks/research_container_runner.py
COPY ./src/backend/app/tasks/research_collab_container_runner.py /app/backend/app/tasks/research_collab_container_runner.py
COPY ./src/backend/app/tasks/task_config_crypto.py           /app/backend/app/tasks/task_config_crypto.py
COPY ./docker/knowledge-parser/runner.py                      /app/knowledge-parser/runner.py
COPY ./docker/knowledge-parser/plan_store.py                  /app/knowledge-parser/plan_store.py
COPY ./docker/knowledge-parser/sdk_events.py                  /app/knowledge-parser/sdk_events.py
COPY ./docker/knowledge-parser/PROMPT.md                      /app/knowledge-parser/PROMPT.md
COPY ./docker/knowledge-parser/PLAN_PROMPT.md                 /app/knowledge-parser/PLAN_PROMPT.md
COPY ./docker/knowledge-parser/REFINEMENT_PROMPT.md           /app/knowledge-parser/REFINEMENT_PROMPT.md
COPY ./docker/knowledge-parser/PLAN_SCHEMA.json               /app/knowledge-parser/PLAN_SCHEMA.json
COPY ./docker/knowledge-parser/CC-SWITCH-LICENSE              /usr/share/licenses/cc-switch/LICENSE

# ---------- 创建非 root 用户，提升安全性,git 目录权限问题，暂时使用root ----------
# RUN useradd --create-home --shell /bin/bash taskrunner
# USER taskrunner

# ---------- 启动任务执行器 ----------
CMD ["python", "app/tasks/container_runner.py"]
