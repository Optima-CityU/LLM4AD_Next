# 本地开发环境示例配置文件，根据实际情况修改。部署基础服务，前后端本地启动。
# 前端地址，用于生成邮件中的链接等，必需是公网可访问的地址
FRONTEND_HOST=http://localhost:5173

# 环境名： local-本地调试, staging, production-生产
ENVIRONMENT=local

# 项目唯一名称，必需小写
PROJECT_NAME=llm4ad-web
# backend 动态创建的容器要加入的 Docker 网络。
# task runner 需要访问 gateway；code-server 只需要被 gateway 反代访问。
TASK_CONTAINER_NETWORK_NAME=llm4ad-web_task_runtime
CODE_SERVER_NETWORK_NAME=llm4ad-web_code_runtime
CHAT_TUNE_CONTAINER_NETWORK_NAME=llm4ad-web_chat_tune_runtime
# runner 需要访问外部模型/供应商域名时保持 false；code-server 网络仍固定 internal。
TASK_RUNTIME_NETWORK_INTERNAL=false

# 可通过python生成 `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=xxxx

# 供应商凭据加密专用密钥（与 SECRET_KEY 解耦）。务必显式设置且设置后不要再变更：
# 留空会回退到 SECRET_KEY 派生，而 SECRET_KEY 一旦轮换或在裸 python 本地运行时
# 取随机默认值，会导致已加密的供应商凭据无法解密（重启后凭据静默丢失）。
# 生成方式同上：`python -c "import secrets; print(secrets.token_urlsafe(32))"`
PROVIDER_ENCRYPTION_KEY=xxxx

# 首个超级管理员账户
FIRST_SUPERUSER=xxxx@qq.com
FIRST_SUPERUSER_PASSWORD=xxxx

# ---------- SMTP (Email) ----------
# 邮件服务，开发使用`mailcatcher`拦截，生产请改为真实的邮件服务器配置
SMTP_HOST=localhost
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_SSL=False
SMTP_PORT=1025

# ---------- PostgreSQL ----------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxxx

# ---------- Sentry (Optional) ----------
SENTRY_DSN=

# ---------- Docker Images ----------
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# ---------- RustFS (Object Storage) ----------
RUSTFS_ACCESS_KEY=xxxx
RUSTFS_SECRET_KEY=xxxx
RUSTFS_ENDPOINT=http://localhost:9000

# ---------- Redis ----------
REDIS_PASSWORD=xxxx
REDIS_HOST=localhost
REDIS_PORT=6379

# ---------- Project Home ----------
# 本地调试HOST_PROJECT_HOME和DOCKER_PROJECT_HOME需要一致，部署时HOST_PROJECT_HOME可以是服务器上的任意目录，但必须确保该目录存在且有读写权限。
HOST_PROJECT_HOME=/data/project_home/
DOCKER_PROJECT_HOME=/data/project_home/

# ---------- Code Server Proxy ----------
# 开发: http://host.docker.internal:8000  部署: http://backend:8000
AUTH_BACKEND_URL=http://host.docker.internal:8000

# ---------- Ports ----------
FRONTEND_PORT=18041

VITE_CODE_SERVER_URL=/code_ide

# ---------- Plausible Analytics (Optional) ----------
# 隐私友好的浏览统计，前端使用 @plausible-analytics/tracker 通过 Vite 构建变量注入。
#
# 你在 Plausible 后台生成的脚本形如：
#   <script async src="https://plausible.dadastory.com/js/pa-K7trwUJqBEmpGRhnsZ-nU.js"></script>
#   <script>plausible.init()</script>
#
# 本项目不直接在 index.html 注入上面的 script，而是使用 npm tracker 初始化。
# 对应关系：
#   - script 域名 https://plausible.dadastory.com
#     -> VITE_PLAUSIBLE_ENDPOINT=https://plausible.dadastory.com/api/event
#   - Plausible 后台创建站点时填写的 domain
#     -> VITE_PLAUSIBLE_DOMAIN
#
# 注意：
#   1. VITE_PLAUSIBLE_DOMAIN 必须与 Plausible 后台站点设置中的 domain 一致。
#      例如前端公网地址是 https://app.example.com，则通常填写 app.example.com。
#      本地开发如果要采集 localhost/127.0.0.1 访问，需要 Plausible 后台也有对应站点，
#      并把 VITE_PLAUSIBLE_CAPTURE_ON_LOCALHOST=true。
#   2. 留空 VITE_PLAUSIBLE_DOMAIN 时，本项目会自动禁用统计，避免开发环境误上报。
#   3. VITE_PLAUSIBLE_AUTO_CAPTURE_PAGEVIEWS=false 表示不使用 tracker 内置自动捕获，
#      改由 TanStack Router 在路由解析完成后手动上报 pageview，并附带：
#      path、route_id、title、search、hash。
#   4. 这些变量是前端构建变量，修改后需要重新 build frontend 镜像才会生效。
VITE_PLAUSIBLE_ENABLED=true
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_ENDPOINT=https://plausible.dadastory.com/api/event
VITE_PLAUSIBLE_AUTO_CAPTURE_PAGEVIEWS=false
VITE_PLAUSIBLE_HASH_BASED_ROUTING=false
VITE_PLAUSIBLE_OUTBOUND_LINKS=false
VITE_PLAUSIBLE_FILE_DOWNLOADS=false
VITE_PLAUSIBLE_FORM_SUBMISSIONS=false
VITE_PLAUSIBLE_CAPTURE_ON_LOCALHOST=false
VITE_PLAUSIBLE_LOGGING=true
VITE_PLAUSIBLE_BIND_TO_WINDOW=true

# ---------- Admin Analytics Embed (Optional) ----------
# 管理员「访客统计」页面中 iframe 嵌入的公开统计地址。
# 可填写 Plausible 后台生成的公开分享链接，或其他允许被 iframe 嵌入的 HTTPS/HTTP 页面。
#
# 注意：
#   1. 该值会在前端构建时注入，修改后需要重新 build frontend 镜像。
#   2. 目标页面必须允许被当前站点 iframe 嵌入；如果对方设置了 X-Frame-Options
#      或 Content-Security-Policy frame-ancestors 限制，浏览器会阻止显示。
#   3. 该入口只在超级管理员侧边栏展示；统计页本身的访问权限由你配置的公开地址决定。
# 示例：
#   VITE_ADMIN_ANALYTICS_URL=https://plausible.dadastory.com/share/example.com?auth=xxxx
VITE_ADMIN_ANALYTICS_URL=

# ---------- APT Mirror (Optional) ----------
# 配置 APT 镜像源加速容器构建，留空则使用默认源
# 例如: mirrors.aliyun.com
APT_MIRROR=
UV_INDEX_URL=

JINA_API_KEY=

# 是否跳过注册时邮箱验证，跳过后前端会自动填充验证码
SKIP_EMAIL_VERIFICATION=

# AI构建是否启用容器网络，本地调试使用false否则无法连接容器
CHAT_TUNE_CONTAINER_NETWORK=

# ----------- Gateway config ----------
GATEWAY_SERVER_PORT=9090
GATEWAY_AUTH_URL=http://backend:8000/api/v1/llm4ad/tasks/code_auth/
GATEWAY_USER_ME_URL=http://backend:8000/api/v1/users/me
GATEWAY_SECURITY_PASSWORD=default-password
GATEWAY_SECURITY_SALT=a7e92f8d3c1b6a4e5f8d7c9b0a1d2e3f
LITELLM_AUTH_TOKEN=sk-my-master-key
LITELLM_BASE_URL=http://litellm:4000
# LiteLLM API key 缓存时间，单位秒。缓存命中且 /key/info 校验有效时不会重新生成 key。
LITELLM_API_KEY_TTL=86400
# LiteLLM API key 生成锁过期时间，单位秒。
# 用于防止同一 teamId:userId 在 Redis 缓存 miss 或 key 失效时被并发请求重复调用 /key/generate。
# 正常情况下请求生成完成会主动释放锁；该 TTL 是进程异常、网络中断时的兜底过期时间。
# 建议保持大于一次 LiteLLM /key/generate + Redis 写入的最长耗时，通常 30 秒足够。
LITELLM_API_KEY_LOCK_TTL=30

# 配置团队ID
TEAM_ID=123456


## 内置试用供应商配置
BUILTIN_PROVIDER_NAME=builtin-trial
BUILTIN_PROVIDER_BASE_URL="http://gateway:9090/litellm_proxy/${TEAM_ID}/{accessToken}/v1"
BUILTIN_PROVIDER_API_KEY=1234
# 可留空；为空时后端会从 BUILTIN_PROVIDER_BASE_URL 的 /models 动态读取大模型列表
BUILTIN_PROVIDER_MODELS=
BUILTIN_PROVIDER_MAX_TOKENS=16384
# 可留空；为空且 BUILTIN_PROVIDER_MODELS 有值时取第一个模型。动态模型场景建议由用户在前端选择默认模型。
BUILTIN_PROVIDER_DEFAULT_MODEL=
# 任务运行时的 embedding 模型；云部署默认复用 BUILTIN_PROVIDER_BASE_URL 指向的私有网关。
EMBEDDING_MODEL=jina-embeddings-v4
