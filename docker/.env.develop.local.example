# 本地开发环境示例配置文件，根据实际情况修改。
# 用途：通过 Docker Compose 部署基础服务，前后端在宿主机本地启动。

# =============================================================================
# App 基础配置
# =============================================================================
ENVIRONMENT=local
PROJECT_NAME=llm4ad-web

# 前端地址，用于生成邮件中的链接等；本地前端默认 Vite 端口为 5173。
FRONTEND_HOST=http://localhost:5173

# 是否跳过注册时邮箱验证，跳过后前端会自动填充验证码。
SKIP_EMAIL_VERIFICATION=


# =============================================================================
# 安全密钥与初始化管理员
# =============================================================================
# 可通过python生成 `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SECRET_KEY=xxxx

# 供应商凭据加密专用密钥（与 SECRET_KEY 解耦）。务必显式设置且设置后不要再变更：
# 留空会回退到 SECRET_KEY 派生，而 SECRET_KEY 一旦轮换或在裸 python 本地运行时
# 取随机默认值，会导致已加密的供应商凭据无法解密（重启后凭据静默丢失）。
# 生成方式同上：`python -c "import secrets; print(secrets.token_urlsafe(32))"`
PROVIDER_ENCRYPTION_KEY=xxxx

# 首个超级管理员账户
FIRST_SUPERUSER=xxxx@qq.com
FIRST_SUPERUSER_PASSWORD=xxxx


# =============================================================================
# 邮件服务 SMTP
# =============================================================================
# 邮件服务，开发使用`mailcatcher`拦截，生产请改为真实的邮件服务器配置
SMTP_HOST=localhost
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_SSL=False
SMTP_PORT=1025


# =============================================================================
# 数据库与缓存
# =============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxxx

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=xxxx


# =============================================================================
# 对象存储 RustFS
# =============================================================================
RUSTFS_ACCESS_KEY=xxxx
RUSTFS_SECRET_KEY=xxxx
RUSTFS_ENDPOINT=http://localhost:9000


# =============================================================================
# Docker 镜像、挂载路径与端口
# =============================================================================
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# HOST_PROJECT_HOME 必须是宿主机绝对路径，不能使用 ./app-data 这类相对路径。
# DOCKER_PROJECT_HOME 是容器内挂载路径，Compose 会把 HOST_PROJECT_HOME 挂载到该路径。
HOST_PROJECT_HOME=/data/project_home/
DOCKER_PROJECT_HOME=/data/project_home/

FRONTEND_PORT=18041


# =============================================================================
# Code Server / IDE 代理
# =============================================================================
# 开发: http://host.docker.internal:8000  部署: http://backend:8000
AUTH_BACKEND_URL=http://host.docker.internal:8000
VITE_CODE_SERVER_URL=/code_ide

# 页脚备案号；留空时不显示。
VITE_FOOTER_BEIAN=


# =============================================================================
# 构建与包管理镜像源
# =============================================================================
# 配置 APT 镜像源加速容器构建，留空则使用默认源
# 例如: mirrors.aliyun.com
APT_MIRROR=
UV_INDEX_URL=


# =============================================================================
# MindMemOS 核心依赖
# =============================================================================
LLM4AD_MINDMEMOS_ENABLED=true
LLM4AD_MINDMEMOS_BASE_URL=http://mindmemos-api:8000
LLM4AD_MINDMEMOS_JWT_SECRET=demo-jwt-secret-key
LLM4AD_MINDMEMOS_JWT_ISSUER=demo-jwt-gateway
LLM4AD_MINDMEMOS_JWT_AUDIENCE=demo-jwt-audience
LLM4AD_MINDMEMOS_APP_ID=llm4ad
LLM4AD_MINDMEMOS_AGENT_ID=planner
LLM4AD_MINDMEMOS_FAIL_OPEN=true
LLM4AD_MINDMEMOS_REQUEST_TIMEOUT=10
LLM4AD_MINDMEMOS_ADD_TIMEOUT=120


MINDMEMOS_NEO4J_USERNAME=neo4j
MINDMEMOS_NEO4J_PASSWORD=mindmemos_dev_password
MINDMEMOS_KAFKA_PORT=19092
MINDMEMOS_KAFKA_NUM_PARTITIONS=32

# 以下端口只在 compose.mindmemos.debug.yml 中用于本机调试。
MINDMEMOS_QDRANT_HTTP_PORT=16333
MINDMEMOS_QDRANT_GRPC_PORT=16334
MINDMEMOS_NEO4J_HTTP_PORT=17474
MINDMEMOS_NEO4J_BOLT_PORT=17687
MINDMEMOS_API_PORT=18000


# =============================================================================
# AI 构建与模型代理
# =============================================================================
# AI构建是否启用容器网络，本地调试使用false否则无法连接容器
CHAT_TUNE_CONTAINER_NETWORK=

# 启用llm代理，防止演化任务容器泄露模型调用凭据
LLM_PROXY_ENABLE=

# llm代理的url，如：http://host.docker.internal:8000/api/v1/llm4ad/llmproxy 或 http://llm4ad-web-backend-1:8000/api/v1/llm4ad/llmproxy
LLM_PROXY_BASE_URL=

JINA_API_KEY=


# =============================================================================
# 可选监控集成
# =============================================================================
SENTRY_DSN=
