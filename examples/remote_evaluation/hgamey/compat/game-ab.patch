+#!/usr/bin/env python3
+"""Verify game A/B queue integration with a fixture wrapper and no devices."""
+
+import copy
+import hashlib
+import importlib.util
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+from types import ModuleType
+from unittest.mock import Mock, patch
+
+spec = importlib.util.spec_from_file_location(
+    "game_ab_executor", Path(__file__).parents[1] / "executor.py"
+)
+app = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(app)
+
+
+class GameABExecutorTests(unittest.TestCase):
+    """Exercise executor responsibilities independently of the real game wrapper."""
+
+    def setUp(self):
+        """Install a wrapper fixture and prohibit unmocked external commands."""
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        self.layer = self.root / "upstream.so"
+        self.layer.write_bytes(b"fixture upstream layer")
+        self.config = self.root / "devices.json"
+        self.device = {
+            "id": "fixture-phone",
+            "label": "Fixture",
+            "host": "192.0.2.10",
+            "port": 5555,
+            "expected_serial": "fixture-serial",
+            "enabled": True,
+        }
+        app.write_json(self.config, {"version": 1, "devices": [self.device]})
+        self.wrapper = ModuleType("game_ab")
+        self.wrapper.validate_options = Mock(side_effect=self.validate_options)
+        self.wrapper.freeze_inputs = Mock(side_effect=self.freeze_inputs)
+        modules = patch.dict(sys.modules, {"game_ab": self.wrapper})
+        modules.start()
+        self.addCleanup(modules.stop)
+        commands = patch.object(
+            app, "command", side_effect=AssertionError("Unexpected external command")
+        )
+        self.commands = commands.start()
+        self.addCleanup(commands.stop)
+        self.engines, self.gates = [], []
+
+    def tearDown(self):
+        """Release fixture workers before removing their temporary journals."""
+        for gate in self.gates:
+            gate.set()
+        for engine in reversed(self.engines):
+            engine.close()
+
+    def validate_options(self, options):
+        """Return fixture defaults through the parent's declared wrapper API."""
+        if not isinstance(options, dict):
+            raise TypeError("fixture options must be an object")
+        return {
+            "package": "com.fixture.game",
+            "a": "native",
+            "b": "sr:0.7:1920x1080",
+            "rounds": 2,
+            "window": 10,
+            "settle": 20,
+            "enter_script": None,
+            "layer_path": str(self.layer),
+            "timeout_seconds": 600,
+            "pan": False,
+            "cool_max": 0,
+            **options,
+        }
+
+    @staticmethod
+    def freeze_inputs(folder, frozen):
+        """Stage fixture bytes using the existing executor manifest contract."""
+        options = frozen["submission"]["options"]
+        source = Path(options["layer_path"])
+        target = folder / "inputs" / "game-ab" / "layer.so"
+        target.parent.mkdir(parents=True)
+        data = source.read_bytes()
+        target.write_bytes(data)
+        target.chmod(0o444)
+        options["layer_path"] = str(target)
+        frozen.setdefault("input_files", []).append(
+            {
+                "source": str(source),
+                "path": target.relative_to(folder).as_posix(),
+                "sha256": hashlib.sha256(data).hexdigest(),
+                "bytes": len(data),
+            }
+        )
+
+    def engine(self, runner):
+        """Start the real serialized queue with a fixture backend."""
+        engine = app.Engine(self.root / "data", self.config, runner)
+        self.engines.append(engine)
+        return engine
+
+    def gate(self):
+        """Create a worker gate that teardown always releases."""
+        gate = threading.Event()
+        self.gates.append(gate)
+        return gate
+
+    def wait(self, engine, job_id):
+        """Wait for a bounded fixture execution to reach its terminal state."""
+        deadline = time.monotonic() + 3
+        while time.monotonic() < deadline:
+            job = engine.get(job_id)
+            if job["state"] not in {"queued", "running", "cancel_requested"}:
+                return job
+            time.sleep(0.005)
+        self.fail("Fixture job did not finish")
+
+    def folder(self, **submission):
+        """Prepare a job exactly as the device worker receives it."""
+        folder = self.root / "job"
+        folder.mkdir()
+        frozen = app.prepare_submission(
+            {"operation": "game-ab", **submission}, app.load_devices(self.config)
+        )
+        self.wrapper.freeze_inputs(folder, frozen)
+        app.write_json(folder / "input.json", frozen)
+        return folder
+
+    @staticmethod
+    def receipts(folder, restored=True):
+        """Write diagnostic-only fixture output and ordinary foreground receipts."""
+        app.write_json(
+            folder / "result.json",
+            {
+                "status": "PASS",
+                "candidate_applied": False,
+                "conditions_observed": {"restored": restored},
+            },
+        )
+        app.write_json(
+            folder / "foreground.json",
+            {"previous": "com.fixture.game/.Main", "paused": False, "restore_required": False},
+        )
+
+    def test_submission_delegates_validation_and_preserves_original(self):
+        """Normalize only the frozen options and retain the selected device."""
+        body = {"operation": "game-ab", "options": {"rounds": 3}}
+        original = copy.deepcopy(body)
+        frozen = app.prepare_submission(body, app.load_devices(self.config))
+        self.wrapper.validate_options.assert_called_once_with({"rounds": 3})
+        self.assertEqual(body, original)
+        self.assertEqual(frozen["submission"]["options"]["rounds"], 3)
+        self.assertEqual(frozen["submission"]["options"]["package"], "com.fixture.game")
+        self.assertEqual(frozen["device"]["expected_serial"], "fixture-serial")
+        self.assertIn("game_ab", app.FEATURES)
+        self.commands.assert_not_called()
+
+    def test_invalid_options_and_eval_request_are_rejected(self):
+        """Reject invalid wrapper options and mixed operation protocols."""
+        devices = app.load_devices(self.config)
+        for body in (
+            {"operation": "game-ab", "options": []},
+            {"operation": "game-ab", "request": {"version": 2, "kind": "shader"}},
+        ):
+            with self.subTest(body=body), self.assertRaises((TypeError, ValueError)):
+                app.prepare_submission(body, devices)
+        self.commands.assert_not_called()
+
+    def test_queue_freezes_layer_and_reuses_idempotent_submission(self):
+        """A game job shares probe serialization and retains its original layer."""
+        entered, release = self.gate(), self.gate()
+
+        def runner(folder):
+            entered.set()
+            release.wait(3)
+            return 0
+
+        engine = self.engine(runner)
+        engine.submit({"operation": "probe"})
+        self.assertTrue(entered.wait(1))
+        body = {"operation": "game-ab", "idempotency_key": "a" * 64}
+        job = engine.submit(body)
+        self.assertEqual(engine.get(job["id"])["state"], "queued")
+        folder = engine.jobs / job["id"]
+        frozen = app.read_json(folder / "input.json")
+        layer = Path(frozen["submission"]["options"]["layer_path"])
+        self.layer.write_bytes(b"changed outside the queue")
+        self.assertEqual(layer.read_bytes(), b"fixture upstream layer")
+        self.assertEqual(frozen["submitted_body"], {"operation": "game-ab"})
+        app.verify_frozen_inputs(folder, frozen)
+        self.assertEqual(engine.submit(body)["id"], job["id"])
+        self.wrapper.freeze_inputs.assert_called_once()
+        with self.assertRaises(app.SubmissionConflict):
+            engine.submit({**body, "options": {"rounds": 3}})
+        self.assertEqual(engine.cancel(job["id"])["state"], "cancelled")
+        self.commands.assert_not_called()
+
+    def test_freeze_failure_never_publishes_a_job(self):
+        """A missing layer cannot become accepted queue work."""
+        engine = self.engine(lambda _: self.fail("Unexpected execution"))
+        self.wrapper.freeze_inputs.side_effect = FileNotFoundError("fixture layer missing")
+        with self.assertRaises(FileNotFoundError):
+            engine.submit({"operation": "game-ab", "idempotency_key": "a" * 64})
+        self.assertFalse(list(engine.jobs.glob("*/job.json")))
+        with self.assertRaises(KeyError):
+            engine.get_by_key("a" * 64)
+
+    def test_tampered_layer_is_rejected_before_device_work(self):
+        """Reuse the executor's file verifier for game layer snapshots."""
+        folder = self.folder()
+        frozen = app.read_json(folder / "input.json")
+        layer = Path(frozen["submission"]["options"]["layer_path"])
+        layer.chmod(0o644)
+        layer.write_bytes(b"tampered")
+        with patch.object(app, "sync_registry") as registry:
+            with self.assertRaises(app.BackendNotStarted):
+                app.run_backend(folder)
+            registry.assert_not_called()
+        self.commands.assert_not_called()
+
+    def test_backend_validates_game_options_without_eval_preflight(self):
+        """Game jobs enter the existing lease after wrapper-only validation."""
+        folder = self.folder()
+        self.wrapper.validate_options.reset_mock()
+
+        def worker(argv, **kwargs):
+            self.assertEqual(argv[:2], ["phonefarm", "lease"])
+            self.assertNotIn("--validate-only", argv)
+            self.receipts(folder)
+            return subprocess.CompletedProcess(argv, 0)
+
+        with patch.object(app, "sync_registry") as registry:
+            with patch.object(app, "command", side_effect=worker) as command:
+                self.assertEqual(app.run_backend(folder), 0)
+                command.assert_called_once()
+            registry.assert_called_once()
+        self.wrapper.validate_options.assert_called_once_with(
+            app.read_json(folder / "input.json")["submission"]["options"]
+        )
+        self.assertFalse((folder / "eval-request.json").exists())
+
+    def test_backend_validation_failure_is_safe_preflight_failure(self):
+        """Invalid persisted options cannot reach registry or device commands."""
+        folder = self.folder()
+        self.wrapper.validate_options.side_effect = ValueError("invalid game options")
+        with patch.object(app, "sync_registry") as registry:
+            with self.assertRaisesRegex(app.BackendNotStarted, "invalid game options"):
+                app.run_backend(folder)
+            registry.assert_not_called()
+        self.commands.assert_not_called()
+
+    def device_worker(self, folder, previous, result="valid", serial="fixture-serial", window=None, activity="", cleanup=None):
+        """Run the device worker with fully intercepted ADB and wrapper calls.
+
+        Args:
+            folder: Frozen fixture job directory.
+            previous: Foreground activity reported by the fixture phone.
+            result: Wrapper report fixture, valid, missing, or malformed.
+            serial: Physical identity returned by the fixture transport.
+            window: Optional exact window dump, including null focus.
+            activity: Exact activity dump used only by fallback identification.
+            cleanup: Optional upstream cleanup receipt.
+
+        Returns:
+            Worker exit code and intercepted command arguments.
+        """
+        calls = []
+        self.device_calls = calls
+
+        def command(argv, **kwargs):
+            calls.append(argv)
+            stdout = ""
+            if argv[0] == sys.executable:
+                self.assertEqual(
+                    argv, [sys.executable, "/opt/gateway/adapter/game_ab.py", "--job", str(folder)]
+                )
+                self.assertTrue(kwargs["pf"])
+                kwargs["stdout"].write("Upstream progress and Markdown, not JSON\n")
+                if result == "valid":
+                    self.receipts(folder)
+                elif result == "malformed":
+                    (folder / "result.json").write_text("[]")
+                elif isinstance(result, dict):
+                    app.write_json(folder / "result.json", result)
+                if cleanup is not None:
+                    (folder / "evidence").mkdir(exist_ok=True)
+                    app.write_json(folder / "evidence/restore.json", cleanup)
+                return subprocess.CompletedProcess(argv, 1)
+            self.assertEqual(argv[0], "/usr/bin/adb")
+            if argv[-1] == "get-state":
+                stdout = "device\n"
+            elif argv[-1] == "ro.serialno":
+                stdout = serial + "\n"
+            elif argv[-1] == "dumpsys window":
+                stdout = window if window is not None else f"mCurrentFocus=Window{{1 u0 {previous}}}"
+            elif argv[-1] == "dumpsys activity activities":
+                stdout = activity
+            elif "start" in argv:
+                stdout = "Status: ok\n"
+            return subprocess.CompletedProcess(argv, 0, stdout=stdout, stderr="")
+
+        with (
+            patch.object(app, "inherited_fds", return_value=(1,)),
+            patch.object(app, "command", side_effect=command),
+        ):
+            return app.execute_on_device(folder), calls
+
+    def test_device_worker_reads_file_and_restores_other_foreground(self):
+        """Non-JSON stdout never replaces the wrapper's diagnostic envelope."""
+        folder = self.folder(pause_foreground=True)
+        code, calls = self.device_worker(folder, "com.fixture.other/.Main")
+        self.assertEqual(code, 1)
+        report = app.read_json(folder / "result.json")
+        self.assertIs(report["candidate_applied"], False)
+        self.assertNotIn("score", report)
+        self.assertTrue(app.cleanup_completed(folder, "game-ab"))
+        self.assertTrue(any("force-stop" in argv for argv in calls))
+        self.assertEqual(calls[-1][-2:], ["-n", "com.fixture.other/.Main"])
+        self.assertIn("not JSON", (folder / "backend.stdout").read_text())
+
+    def test_target_package_uses_normal_foreground_policy(self):
+        """The game package is not mistaken for the default refbench target."""
+        folder = self.folder(pause_foreground=True)
+        _, calls = self.device_worker(folder, "com.fixture.game/.Main")
+        self.assertFalse(any("force-stop" in argv or "start" in argv for argv in calls))
+        self.assertTrue(app.cleanup_completed(folder, "game-ab"))
+
+    def test_missing_report_defers_foreground_restore(self):
+        """A missing wrapper receipt leaves native ownership unconfirmed."""
+        folder = self.folder()
+        with self.assertRaises(FileNotFoundError):
+            self.device_worker(folder, "com.fixture.other/.Main", result="missing")
+        self.assertIsNone(app.read_json(folder / "foreground.json")["restored"])
+        self.assertFalse(any("start" in argv for argv in self.device_calls))
+        self.assertFalse(app.cleanup_completed(folder, "game-ab"))
+
+    def test_non_object_report_is_rejected_and_preserved(self):
+        """Malformed report evidence survives a failed wrapper execution."""
+        folder = self.folder()
+        with self.assertRaisesRegex(ValueError, "JSON object"):
+            self.device_worker(folder, "com.fixture.other/.Main", result="malformed")
+        self.assertEqual((folder / "result.json").read_text(), "[]")
+        self.assertIsNone(app.read_json(folder / "foreground.json")["restored"])
+        self.assertFalse(any("start" in argv for argv in self.device_calls))
+
+    def test_null_focus_uses_exact_resumed_activity_fields(self):
+        """Recognize Android 15 resumed records without using paused history."""
+        base = self.folder()
+        component = "com.fixture.other/com.fixture.MainActivity"
+        for index, fields in enumerate((
+            ("topResumedActivity=",), ("mResumedActivity:",),
+            ("ResumedActivity:",), ("Resumed:",), ("Resumed:", "ResumedActivity:"),
+        )):
+            with self.subTest(fields=fields):
+                folder = base / str(index)
+                folder.mkdir()
+                (folder / "input.json").write_bytes((base / "input.json").read_bytes())
