+        self.assertEqual((Path(payload["spirv_path"]).parent / "baseline.spv").read_bytes(), b"baseline original")
+        self.assertEqual(engine.submit(body)["id"], job["id"])
+        app.verify_frozen_inputs(folder, frozen)
+        self.assertEqual(len(list(folder.glob("inputs/**/*txt"))), 0)
+        engine.cancel(job["id"])
