+    def test_operator_resolution_releases_only_confirmed_inactive_quarantine(self):
+        """Quarantine requires explicit local operator confirmation, never a retry."""
+        entered, release = self.gate(), self.gate()
+        def run(folder):
+            entered.set()
+            release.wait(3)
+            return 0
+        engine = self.engine(run)
+        active = engine.submit({"operation": "probe"})
+        self.assertTrue(entered.wait(1))
+        confirmation = {"confirmed_stopped": True, "confirmed_restored": True}
+        path = "/v1/jobs/" + active["id"] + "/resolve"
+        self.assertEqual(self.request(engine, "POST", path, confirmation)[0], 409)
+        release.set()
+        self.wait(engine, active["id"])
+        key = "e" * 32
+        folder = engine.jobs / key
+        folder.mkdir()
+        app.write_json(folder / "job.json", {"id": key, "state": "interrupted", "cleanup_status": "uncertain", "created_at": 1})
+        engine.blocked_jobs.add(key)
+        path = "/v1/jobs/" + key + "/resolve"
+        for invalid in ({}, {"confirmed_stopped": True}, {"confirmed_stopped": True, "confirmed_restored": False}, {"confirmed_stopped": 1, "confirmed_restored": True}):
+            self.assertEqual(self.request(engine, "POST", path, invalid)[0], 400)
+            self.assertIn(key, engine.blocked_jobs)
+        status, resolved = self.request(engine, "POST", path, confirmation)
+        self.assertEqual(status, 200)
+        self.assertEqual((resolved["state"], resolved["cleanup_status"]), ("cancelled", "completed"))
+        self.assertEqual(resolved["cleanup_confirmation"]["source"], "operator")
+        self.assertNotIn(key, engine.blocked_jobs)
+        engine.close()
+        reopened = self.engine()
+        self.assertEqual(reopened.get(key)["cleanup_confirmation"]["source"], "operator")
+        self.assertEqual(reopened.health()["status"], "ok")
+
