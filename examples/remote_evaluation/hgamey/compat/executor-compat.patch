+def sync_directory(path):
+    """Persist directory entries after an atomic metadata publication.
+
+    Args:
+        path: Directory containing the newly published entries.
+    """
+    directory = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(directory)
+    finally:
+        os.close(directory)


