+#!/usr/bin/env python3
+"""Unit tests with fake transports and evidence; no device operations or claims."""
+
+import argparse
+import importlib.util
+import os
+import shlex
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import Mock, patch
+
+SPEC = importlib.util.spec_from_file_location(
+    "present_probe", Path(__file__).parents[1] / "tools/experiments/run_present_probe.py"
+)
+probe = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(probe)
+
+
+class FakeTransport:
+    """Model property readbacks and inner recovery using local synthetic records."""
+
+    adb = "/fake/lease/adb"
+
+    def __init__(self, out):
+        """Initialize synthetic properties and failure controls."""
+        self.out = out
+        self.calls = []
+        self.properties = dict(zip(probe.PROPERTIES, ("", "original live"), strict=False))
+        self.boot = "12345678-1234-1234-1234-123456789abc"
+        self.physical = "fake-usb"
+        self.target_alive = False
+        self.fail_write = False
+        self.fail_recover = False
+
+    def call(self, argv, **kwargs):
+        """Model the supported commands without starting a subprocess."""
+        self.calls.append((argv, kwargs))
+        if "session-recover" in argv:
+            if self.fail_recover:
+                raise RuntimeError("synthetic native recovery refusal")
+            descriptor = probe.read_json(self.out / "inner/session-control.json")
+            descriptor.update(phase="closed", recovery={"status": "reported_complete"})
+            probe.durable(self.out / "inner/session-control.json", descriptor)
+            return "{}"
+        if argv[:4] != [self.adb, "-s", "fake-usb", "shell"]:
+            raise AssertionError(f"unexpected fake command: {argv}")
+        command = shlex.split(argv[4])
+        if command == ["getprop", "ro.serialno"]:
+            return self.physical + "\n"
+        if command == ["cat", "/proc/sys/kernel/random/boot_id"]:
+            return self.boot + "\n"
+        if command[:1] == ["getprop"]:
+            return self.properties[command[1]] + "\n"
+        if command[:1] == ["setprop"]:
+            state = probe.load_state(self.out)
+            assert state["pending_write"]["property"] == command[1]
+            assert state["pending_write"]["value"] == command[2]
+            assert state["restore_required"] is True
+            if self.fail_write:
+                raise RuntimeError("synthetic write timeout")
+            self.properties[command[1]] = command[2]
+            return ""
+        if command == ["su", "-c", "ps -A -o NAME"]:
+            return "NAME\ninit\n" + ("com.test.game:render\n" if self.target_alive else "")
+        raise AssertionError(f"unexpected fake shell: {command}")
+
+    def spawn(self, argv):
+        """Reject unexpected inner launches in recovery unit tests."""
+        raise AssertionError(f"unexpected inner launch: {argv}")
+
+    def writes(self):
+        """Return the recorded synthetic property writes."""
+        return [argv for argv, _ in self.calls if len(argv) > 4 and argv[4].startswith("setprop ")]
+
+
+class PresentProbeTests(unittest.TestCase):
+    """Check only host lifecycle and recovery boundaries with fake evidence."""
+
+    def setUp(self):
+        """Create an isolated probe context and fake transport."""
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        root = Path(self.tmp.name)
+        so = root / "fixture.so"
+        so.write_bytes(b"synthetic candidate, not an Android library")
+        args = argparse.Namespace(out=str(root / "probe"), so=str(so), candidate_receipt=None,
+                                  serial="fake-usb", expected_physical_serial="fake-usb", transport="usb",
+                                  adb_server_socket="tcp:127.0.0.1:5037", package="com.test.game",
+                                  duration=60, phonefarm="/fake/phonefarm")
+        self.out = probe.initialize(args)
+        self.transport = FakeTransport(self.out)
+        self.owner = probe.Probe(self.out, self.transport)
+
+    def inner(self, complete=True):
+        """Publish synthetic inner-session recovery evidence."""
+        (self.out / "inner").mkdir(exist_ok=True)
+        sid = "gray-session-123-456"
+        probe.durable(self.out / "inner/session-control.json", {
+            "schema": "phonefarm/gray-control@1", "producer": "phonefarm", "serial": "fake-usb",
+            "package": "com.test.game", "session_id": sid, "session_path": sid,
+            "phase": "closed" if complete else "recovery_required", "controller": {"epoch": 1},
+            "recovery": {"status": "reported_complete" if complete else "required"},
+        })
+        self.owner.state["inner_launch"] = "started"
+        self.owner.save()
+
+    def test_normal_cleanup_restores_exact_originals_after_inner_and_absence(self):
+        """Require inner completion and target absence before restoring originals."""
+        self.owner.prepare()
+        self.assertEqual(self.transport.properties, dict(zip(probe.PROPERTIES, ("native", "0"), strict=False)))
+        self.inner()
+        self.owner.cleanup()
+        self.assertEqual(self.transport.properties, dict(zip(probe.PROPERTIES, ("", "original live"), strict=False)))
+        self.assertEqual(self.owner.state["phase"], "closed")
+        self.assertIsNone(self.owner.state["pending_write"])
+        self.assertFalse(self.owner.state["restore_required"])
+        calls = [argv[-1] for argv, _ in self.transport.calls]
+        self.assertLess(calls.index("su -c 'ps -A -o NAME'"), calls.index("setprop debug.knobs.selfsr ''"))
+
+    def test_unknown_write_is_durable_and_recovery_does_not_replay(self):
+        """Retain unknown writes and refuse to replay them during recovery."""
+        self.transport.fail_write = True
+        with self.assertRaisesRegex(RuntimeError, "write timeout"):
+            self.owner.prepare()
+        self.assertIsNotNone(probe.load_state(self.out)["pending_write"])
+        self.transport.calls.clear()
+        recovered = probe.Probe(self.out, self.transport)
+        self.assertEqual(recovered.run(recover=True), 2)
+        self.assertEqual(self.transport.calls, [])
+        self.assertEqual(recovered.state["phase"], "recovery_required")
+
+    def test_inner_recovery_failure_prevents_outer_restoration(self):
+        """Keep outer obligations when native recovery fails."""
+        self.owner.prepare()
+        self.inner(complete=False)
+        self.transport.fail_recover = True
+        self.transport.calls.clear()
+        self.assertEqual(self.owner.run(recover=True), 2)
+        self.assertEqual(self.transport.writes(), [])
+        self.assertTrue(self.owner.state["restore_required"])
+
+    def test_recover_uses_original_inner_context_and_preserves_old_failure(self):
+        """Recover the original inner context without erasing prior failures."""
+        self.owner.prepare()
+        self.inner(complete=False)
+        self.owner.state["failures"].append({"error": "original failure"})
+        self.owner.save()
+        self.assertEqual(self.owner.run(recover=True), 0)
+        command = next(argv for argv, _ in self.transport.calls if "session-recover" in argv)
+        self.assertIn(str(self.out / "inner/gray-session-123-456"), command)
+        self.assertEqual(self.owner.state["failures"][0]["error"], "original failure")
+        self.assertEqual(self.owner.state["phase"], "closed")
+
+    def test_changed_boot_or_physical_identity_prevents_cleanup_writes(self):
+        """Reject cleanup mutations after boot or physical identity changes."""
+        self.owner.prepare()
+        self.inner(complete=False)
+        self.transport.calls.clear()
+        self.transport.boot = "ffffffff-1234-1234-1234-123456789abc"
+        self.assertEqual(self.owner.run(recover=True), 2)
+        self.assertEqual(self.transport.writes(), [])
+        self.assertFalse(any("session-recover" in argv for argv, _ in self.transport.calls))
+        self.transport.boot = self.owner.state["boot_id"]
+        self.transport.physical = "wrong-phone"
+        self.transport.calls.clear()
+        self.assertEqual(self.owner.run(recover=True), 2)
+        self.assertEqual(self.transport.writes(), [])
+
+    def test_target_child_process_prevents_original_property_restoration(self):
+        """Require target child processes to exit before property restoration."""
+        self.owner.prepare()
+        self.inner()
+        self.transport.target_alive = True
+        self.transport.calls.clear()
+        with self.assertRaisesRegex(ValueError, "target is still alive"):
+            self.owner.cleanup()
+        self.assertEqual(self.transport.writes(), [])
+
+    def test_host_publish_is_idempotent_without_subprocesses(self):
+        """Publish duplicate requests idempotently without running commands."""
+        self.owner.state["accepting"] = True
+        self.owner.save()
+        with (
+            probe.lock(self.out / "owner.lock"),
+            patch.object(probe.subprocess, "Popen", side_effect=AssertionError("subprocess forbidden")),
+        ):
+            first = probe.publish(self.out, "enable-1", "enable")
+            self.assertEqual(probe.publish(self.out, "enable-1", "enable"), first)
+            with self.assertRaisesRegex(ValueError, "different content"):
+                probe.publish(self.out, "enable-1", "disable")
+
+    def test_started_request_is_never_replayed(self):
+        """Reject a previously started request without a final receipt."""
+        request = {"request_id": "unknown-1", "action": "enable", "sequence": 1}
+        probe.durable(self.out / "requests/unknown-1.json", request)
+        probe.durable(self.out / "started/unknown-1.json", request)
+        with self.assertRaisesRegex(ValueError, "refusing replay"):
+            self.owner.process_requests()
