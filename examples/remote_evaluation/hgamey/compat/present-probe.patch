+    def test_inner_launch_and_transport_preserve_fds_and_socket(self):
+        """Pass the inherited lease descriptors and ADB endpoint to children."""
+        env = {"ADB_BIN": "/fake/lease/adb", "PF_TRANSPORT_ADB": "/fake/real/adb",
