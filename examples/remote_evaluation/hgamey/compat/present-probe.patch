@@ -0,0 +1,118 @@
+"""Build an experimental present-stage layer with an exact adapted candidate."""
+
+import argparse
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+from pathlib import Path
+
+
+def digest(path: Path) -> str:
+    """Return the SHA-256 digest of an artifact."""
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def main() -> None:
+    """Compile and freeze a candidate without contacting a device."""
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, required=True)
+    parser.add_argument("--ndk", type=Path, required=True)
+    parser.add_argument("--phonefarm", type=Path, required=True)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--kind", choices=("seed", "diagnostic"), required=True)
+    args = parser.parse_args()
+    ndk = args.ndk.resolve(strict=True)
+    phonefarm = args.phonefarm.resolve(strict=True)
+    out = args.out.resolve()
+    out.mkdir(parents=True, exist_ok=False)
+    source = out / "candidate.comp"
+    shutil.copyfile(args.source.resolve(strict=True), source)
+    glslc = ndk / "shader-tools/linux-x86_64/glslc"
+    cxx = ndk / "toolchains/llvm/prebuilt/linux-x86_64/bin/aarch64-linux-android30-clang++"
+    original = out / "original.spv"
+    subprocess.run(
+        [str(glslc), "--target-env=vulkan1.1", "-O", str(source), "-o", str(original)],
+        check=True, timeout=60,
+    )
+    adapter = out / "adaptation"
+    receipt = subprocess.check_output(
+        [str(phonefarm), "gray-artifact", "adapt-storage", "--source", str(source),
+         "--spirv", str(original), "--out", str(adapter), "--json"],
+        timeout=60,
+    )
+    (out / "adaptation-receipt.json").write_bytes(receipt)
+    adapter = Path(json.loads(receipt)["path"]).resolve(strict=True)
+    if not adapter.is_relative_to(out / "adaptation"):
+        raise ValueError("Adaptation escaped the owned output directory")
+    subprocess.run(
+        [str(phonefarm), "gray-artifact", "verify-adaptation", "--artifact", str(adapter)],
+        check=True, timeout=60, stdout=subprocess.DEVNULL,
+    )
+    adapted = adapter / "adapted.spv"
+    gray = out / "gray"
+    repository = Path(__file__).resolve().parents[2]
+    shutil.copytree(
+        repository / "vendor/hgamey/phonefarm/knobs/gray", gray,
+        ignore=shutil.ignore_patterns("out", "__pycache__"),
+    )
+    env = dict(os.environ, REFBENCH_NDK=str(ndk))
+    with (out / "native-build.log").open("w") as log:
+        # Generate the shared modules using the repository's actual build recipe.
+        subprocess.run(
+            ["bash", str(gray / "build/build_layer.sh")], env=env,
+            stdout=log, stderr=subprocess.STDOUT, check=True, timeout=180,
+        )
+        generated = gray / "build/out"
+        with (generated / "selfsr_spv.h").open("w") as header:
+            for name, binary in (
+                ("kSelfsrUpSpv", adapted),
+                ("kSelfsrRcasSpv", generated / "selfsr_rcas.spv"),
+            ):
+                data = binary.read_bytes()
+                header.write(f"alignas(4) static const unsigned char {name}[] = {{\n")
+                for start in range(0, len(data), 16):
+                    header.write(
+                        "  " + ",".join(str(value) for value in data[start:start + 16]) + ",\n"
+                    )
+                header.write(f"}};\nstatic const unsigned int {name}Len = {len(data)};\n")
+        metadata = {
+            "kSelfsrCandidateSourceSha256": digest(source),
+            "kSelfsrCandidateSpirvSha256": digest(adapted),
+            "kSelfsrCandidateKind": args.kind,
+        }
+        (generated / "selfsr_candidate_metadata.h").write_text("".join(
+            f"static const char {key}[] = {json.dumps(value)};\n"
+            for key, value in metadata.items()
+        ))
+        config = json.loads((gray / "build/layer_build.json").read_text())
+        layer = out / "libVkLayer_refknobs.so"
+        subprocess.run(
+            [str(cxx), *config["compile_flags"], "-I", str(generated), "-o", str(layer),
+             *(str(gray / "layer" / name) for name in config["sources"]),
+             *config["link_flags"]],
+            stdout=log, stderr=subprocess.STDOUT, check=True, timeout=180,
+        )
+    frozen = [source, original, adapted, layer,
+              generated / "selfsr_spv.h", generated / "selfsr_candidate_metadata.h"]
+    frozen += sorted((gray / "layer").glob("*"))
+    frozen += sorted(generated.glob("*"))
+    frozen += [gray / "build/layer_build.json", gray / "build/build_layer.sh"]
+    manifest = {
+        "schema": "llm4ad/experimental-present-candidate@1",
+        "kind": args.kind, "scope": "same_extent_present_stage_postprocessing",
+        "original_game_upscaler_replaced": False, "device_validation": "not_run",
+        "source_sha256": digest(source), "adapted_spirv_sha256": digest(adapted),
+        "layer_sha256": digest(layer),
+        "files": {str(path.relative_to(out)): digest(path) for path in frozen if path.is_file()},
+        "compiler_version": subprocess.check_output([str(cxx), "--version"], text=True),
+        "ndk_properties": (ndk / "source.properties").read_text(),
+    }
+    (out / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    print(json.dumps({"artifact": str(out), "layer_sha256": manifest["layer_sha256"],
+                      "device_validation": "not_run", "kind": args.kind}))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/experiments/run_present_probe.py b/tools/experiments/run_present_probe.py
new file mode 100644
--- /dev/null
+++ b/tools/experiments/run_present_probe.py
@@ -0,0 +1,581 @@
+#!/usr/bin/env python3
+"""Own an experimental selfsr probe around a supported phonefarm session.
+
+The outer journal owns only selfsr properties. Inner recovery owns the layer and
+target. Recovery never replays requests or guesses the outcome of pending writes.
+This local harness is not a production phonefarm API or a device qualification.
+"""
+
+import argparse
+import fcntl
+import hashlib
+import json
+import os
+import re
+import shlex
+import shutil
+import signal
+import stat
+import subprocess
+import sys
+import time
+import uuid
+from contextlib import contextmanager, suppress
+from pathlib import Path
+
+SCHEMA = "phonefarm/experimental-present-probe@1"
+PROPERTIES = ("debug.knobs.selfsr", "debug.knobs.selfsr_live")
+SAFE_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}\Z")
+STOP_ID = "present-probe-stop"
+MAX_REQUESTS = 256
+
+
+def sync_dir(path):
+    """Persist directory entries after publication."""
+    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def atomic_bytes(path, data):
+    """Atomically replace a local artifact with durable bytes."""
+    temp = path.with_name(f".{path.name}-{uuid.uuid4().hex}.tmp")
+    try:
+        with temp.open("xb") as stream:
+            stream.write(data)
+            stream.flush()
+            os.fsync(stream.fileno())
+        os.replace(temp, path)
+        sync_dir(path.parent)
+    finally:
+        temp.unlink(missing_ok=True)
+
+
+def durable(path, value):
+    """Publish a JSON record without partial-reader visibility."""
+    atomic_bytes(path, (json.dumps(value, indent=2, sort_keys=True) + "\n").encode())
+
+
+def read_bytes(path, limit=1024 * 1024):
+    """Read one bounded regular file without following its final symlink."""
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(fd, "rb") as stream:
+        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
+            raise ValueError(f"not a regular file: {path}")
+        data = stream.read(limit + 1)
+    if len(data) > limit:
+        raise ValueError(f"file exceeds limit: {path}")
+    return data
+
+
+def read_json(path):
+    """Read a bounded JSON record."""
+    return json.loads(read_bytes(path))
+
+
+@contextmanager
+def lock(path, blocking=True):
+    """Hold a host-only flock for an owner or mailbox transaction."""
+    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
+    with os.fdopen(fd, "a+") as stream:
+        fcntl.flock(stream, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
+        yield
+
+
+def owner_live(path):
+    """Check a host owner lock without trusting a recorded PID."""
+    if not path.exists():
+        return False
+    try:
+        with lock(path, blocking=False):
+            return False
+    except BlockingIOError:
+        return True
+
+
+def load_state(out):
+    """Validate the original probe context before using it."""
+    value = read_json(out / "probe.json")
+    if (value.get("schema") != SCHEMA or value.get("out") != str(out)
+            or not isinstance(value.get("serial"), str)
+            or not value["serial"] or value.get("transport") not in ("usb", "wireless")
+            or value.get("duration") not in range(1, 601)
+            or not re.fullmatch(r"[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)+", value.get("package", ""))):
+        raise ValueError("invalid or relocated probe context")
+    for name in ("requests", "started", "results", "commands", "inner"):
+        if (out / name).is_symlink():
+            raise ValueError(f"symlink in probe context: {name}")
+    return value
+
+
+def inherited_fds(serial):
+    """Require the original phonefarm device scope and open lock descriptors."""
+    fds = tuple(int(part) for part in os.environ["PF_LOCK_FDS"].split(","))
+    if not fds or any(fd < 3 for fd in fds):
+        raise ValueError("invalid inherited lock descriptors")
+    for fd in fds:
+        os.fstat(fd)
+    scope = json.loads(os.environ["PF_LOCK_SCOPE"])
+    if scope.get("key") is not None and scope.get("serial") != serial:
+        raise ValueError("inherited lease serial differs from explicit target")
+    return fds
+
+
+class Transport:
+    """Run bounded commands through inherited phonefarm transport launchers."""
+
+    def __init__(self, out, state):
+        """Initialize the inherited transport environment for this probe."""
+        self.out = out
+        self.fds = inherited_fds(state["serial"])
+        self.env = dict(os.environ, ADB_SERVER_SOCKET=state["adb_server_socket"])
+        if not self.env.get("PF_TRANSPORT_ADB") or not self.env.get("ADB_BIN"):
+            raise ValueError("phonefarm lease transport launcher is required")
+        self.adb = self.env["ADB_BIN"]
+
+    def call(self, argv, timeout=30, input_text=None):
+        """Keep original output and command outcome, including timeouts."""
+        stem = self.out / "commands" / uuid.uuid4().hex
+        record = {"argv": argv, "started_at": time.time(), "timeout": timeout}
+        durable(stem.with_suffix(".json"), record)
+        with stem.with_suffix(".stdout").open("xb") as stdout, stem.with_suffix(".stderr").open("xb") as stderr:
+            child = subprocess.Popen(argv, stdin=subprocess.PIPE if input_text is not None else subprocess.DEVNULL,
+                                     stdout=stdout, stderr=stderr, env=self.env,
+                                     pass_fds=self.fds, start_new_session=True)
+            try:
+                child.communicate(input_text.encode() if input_text is not None else None, timeout=timeout)
+            except subprocess.TimeoutExpired:
+                with suppress(ProcessLookupError):
+                    os.killpg(child.pid, signal.SIGKILL)
+                child.wait(timeout=5)
+                record.update(status="unknown", error="command timeout; remote completion unknown")
+                durable(stem.with_suffix(".json"), record)
+                raise RuntimeError(f"command timeout; evidence: {stem.name}") from None
+        record.update(returncode=child.returncode, finished_at=time.time())
+        durable(stem.with_suffix(".json"), record)
+        if child.returncode:
+            raise RuntimeError(f"command exit {child.returncode}; evidence: {stem.name}")
+        return read_bytes(stem.with_suffix(".stdout"), 8 * 1024 * 1024).decode()
+
+    def spawn(self, argv):
+        """Launch the finite inner owner with the inherited task descriptors."""
+        with (self.out / "inner.stdout").open("ab") as stdout, (self.out / "inner.stderr").open("ab") as stderr:
+            return subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=stdout, stderr=stderr,
+                                    env=self.env, pass_fds=self.fds)
+
+
+def publish(out, request_id, action):
+    """Publish an idempotent host-only request; never invoke a subprocess."""
+    if not SAFE_ID.fullmatch(request_id) or action not in ("enable", "disable", "stop"):
+        raise ValueError("invalid request ID or action")
+    with lock(out / "publisher.lock"):
+        state = load_state(out)
+        path = out / "requests" / f"{request_id}.json"
+        if path.exists():
+            prior = read_json(path)
+            if prior["action"] != action:
+                raise ValueError("request ID already has different content")
+            result = out / "results" / path.name
+            return read_json(result) if result.exists() else prior
+        if not state["accepting"] or not owner_live(out / "owner.lock"):
+            raise ValueError("probe owner is not accepting requests")
+        requests = [read_json(p) for p in (out / "requests").glob("*.json")]
+        if any(r["action"] == "stop" for r in requests):
+            raise ValueError("stop is already queued")
+        if len(requests) >= MAX_REQUESTS + (action == "stop"):
+            raise ValueError("request limit reached")
+        request = {"request_id": request_id, "action": action, "status": "accepted",
+                   "sequence": max((r["sequence"] for r in requests), default=0) + 1,
+                   "requested_at": time.time()}
+        durable(path, request)
+        return request
+
+
+class Probe:
+    """Serialize the probe's two property obligations and inner-session lifecycle."""
+
+    def __init__(self, out, transport=None):
+        """Load the probe context and initialize its finite owner lifetime."""
+        self.out = out
+        self.state = load_state(out)
+        self.transport = transport if transport is not None else Transport(out, self.state)
+        self.child = None
+        self.cancelled = False
+        self.deadline = time.monotonic() + self.state["duration"]
+
+    def save(self):
+        """Persist the current outer recovery obligations."""
+        durable(self.out / "probe.json", self.state)
+
+    def shell(self, command):
+        """Address exactly the frozen serial through the inherited launcher."""
+        return self.transport.call([self.transport.adb, "-s", self.state["serial"], "shell", command])
+
+    def identity(self):
+        """Verify physical identity and boot before any property transition."""
+        physical = self.shell("getprop ro.serialno").strip()
+        boot = self.shell("cat /proc/sys/kernel/random/boot_id").strip()
+        if physical != self.state["expected_physical_serial"] or not re.fullmatch(r"[A-Fa-f0-9-]{16,64}", boot):
+            raise ValueError("physical serial or boot identity mismatch")
+        if self.state["boot_id"] is not None and boot != self.state["boot_id"]:
+            raise ValueError("device boot changed; original values cannot be restored automatically")
+        return physical, boot
+
+    def property(self, name):
+        """Read one supported property without normalizing its original value."""
+        if name not in PROPERTIES:
+            raise ValueError("unsupported property")
+        value = self.shell(f"getprop {name}").removesuffix("\n")
+        if len(value.encode()) > 91 or any(c in value for c in "\r\n\0"):
+            raise ValueError("invalid property readback")
+        return value
+
+    def write_property(self, name, value, purpose):
+        """Persist intent before setprop and clear it only after verified readback."""
+        if self.state["pending_write"] is not None:
+            raise ValueError("unknown property write requires independent reconciliation; no replay")
+        if name not in PROPERTIES or len(value.encode()) > 91 or any(c in value for c in "\r\n\0"):
+            raise ValueError("invalid property write")
+        self.state.update(restore_required=True, pending_write={"property": name, "value": value,
+                          "purpose": purpose, "at": time.time()})
+        self.save()
+        self.shell(f"setprop {name} {shlex.quote(value)}")
+        if self.property(name) != value:
+            raise ValueError(f"property readback differs: {name}")
+        pending = self.state["pending_write"]
+        self.state["pending_write"] = None
+        try:
+            self.save()
+        except OSError:
+            self.state["pending_write"] = pending
+            raise
+
+    def prepare(self):
+        """Freeze both original values before the first mutation."""
+        physical, boot = self.identity()
+        originals = {name: self.property(name) for name in PROPERTIES}
+        self.state.update(physical_serial=physical, boot_id=boot, originals=originals, phase="prepared")
+        self.save()
+        self.write_property(PROPERTIES[1], "0", "initial_live_off")
+        self.write_property(PROPERTIES[0], "native", "initial_native")
+
+    def descriptor(self):
+        """Read only the inner descriptor bound to this probe's directory."""
+        d = read_json(self.out / "inner" / "session-control.json")
+        sid = d.get("session_id", "")
+        if (d.get("schema") != "phonefarm/gray-control@1" or d.get("producer") != "phonefarm"
+                or d.get("serial") != self.state["serial"] or d.get("package") != self.state["package"]
+                or not re.fullmatch(r"gray-session-[0-9]+-[0-9]+", sid)
+                or d.get("session_path") != sid or (self.out / "inner" / sid).is_symlink()
+                or self.state["inner_id"] not in (None, sid)):
+            raise ValueError("inner descriptor identity mismatch")
+        if self.state["inner_id"] is None:
+            self.state["inner_id"] = sid
+            self.save()
+        return d
+
+    def start_inner(self):
+        """Launch one passdump owner using only the frozen SO snapshot."""
+        so = self.out / "candidate.so"
+        if hashlib.sha256(read_bytes(so, 128 * 1024 * 1024)).hexdigest() != self.state["so_sha256"]:
+            raise ValueError("frozen SO changed")
+        self.state["inner_launch"] = "pending"
+        self.save()
+        argv = [self.state["phonefarm"], "gray-layer", "session", "--mode", "passdump",
+                "--serial", self.state["serial"], "--package", self.state["package"],
+                "--so", str(so), "--out", str(self.out / "inner"),
+                "--max-seconds", str(self.state["duration"]), "--actor-id", "present-probe",
+                "--power-policy", "observe", "--json"]
+        try:
+            self.child = self.transport.spawn(argv)
+        except OSError:
+            self.state["inner_launch"] = "not_started"
+            self.save()
+            raise
+        self.state["inner_launch"] = "started"
+        self.save()
+
+    def result(self, request, status, **fields):
+        """Keep each request's final receipt immutable."""
+        path = self.out / "results" / f"{request['request_id']}.json"
+        if not path.exists():
+            durable(path, dict(request, status=status, finished_at=time.time(), **fields))
+
+    def process_requests(self):
+        """Execute each durable request once, with stop priority at boundaries."""
+        requests = sorted((read_json(p) for p in (self.out / "requests").glob("*.json")),
+                          key=lambda r: (r["action"] != "stop", r["sequence"]))
+        for request in requests:
+            rid = request["request_id"]
+            if not SAFE_ID.fullmatch(rid) or request["action"] not in ("enable", "disable", "stop"):
+                raise ValueError("invalid persisted request")
+            if (self.out / "results" / f"{rid}.json").exists():
+                continue
+            started = self.out / "started" / f"{rid}.json"
+            if started.exists():
+                raise ValueError("started request lacks result; refusing replay")
+            durable(started, dict(request, status="started", started_at=time.time()))
+            if request["action"] == "stop":
+                self.state["stop_request"] = request
+                self.save()
+                return True
+            try:
+                if self.descriptor()["phase"] != "ready":
+                    raise ValueError("inner session is not ready")
+                self.identity()
+                value = "1" if request["action"] == "enable" else "0"
+                self.write_property(PROPERTIES[1], value, rid)
+                self.result(request, "completed", live_property=value, evidence_scope="property_readback_only")
+            except Exception as error:
+                self.result(request, "unknown" if self.state["pending_write"] else "failed", error=str(error))
+                raise
+        return False
+
+    def serve(self):
+        """Accept bounded requests until stop, owner cancellation, or deadline."""
+        while not self.cancelled and time.monotonic() < self.deadline:
+            if self.child.poll() is not None:
+                d = self.descriptor()
+                if d["phase"] == "closed" and d["recovery"]["status"] == "reported_complete":
+                    return
+                raise RuntimeError("inner owner exited before verified recovery")
+            try:
+                d = self.descriptor()
+            except FileNotFoundError:
+                time.sleep(0.1)
+                continue
+            if d["phase"] == "ready":
+                if not self.state["accepting"]:
+                    self.state.update(accepting=True, phase="ready")
+                    self.save()
+                if self.process_requests():
+                    return
+            elif d["phase"] in ("closed", "recovery_required"):
+                raise RuntimeError(f"inner session ended: {d['phase']}")
+            time.sleep(0.1)
+
+    def finish_inner(self, recover):
+        """Stop or recover the original inner context without remounting it."""
+        if self.state["inner_launch"] == "not_started":
+            return
+        d = self.descriptor()
+        live = owner_live(self.out / "inner" / "gray-control" / "owner.lock")
+        if live:
+            request = {"schema": "phonefarm/gray-control-action@1", "request_id": STOP_ID,
+                       "session_id": d["session_id"], "actor_id": "present-probe",
+                       "control_epoch": d["controller"]["epoch"], "action": "stop", "params": {}}
+            saved = self.out / "inner-stop.json"
+            if saved.exists():
+                request = read_json(saved)
+            else:
+                durable(saved, request)
+            self.transport.call([self.state["phonefarm"], "gray-layer", "session-action",
+                                 "--out", str(self.out / "inner"), "--request", "-", "--json"],
+                                input_text=json.dumps(request))
+            deadline = time.monotonic() + 180
+            while owner_live(self.out / "inner" / "gray-control" / "owner.lock"):
+                if time.monotonic() >= deadline:
+                    raise RuntimeError("inner stop remains incomplete; recovery required")
+                time.sleep(0.1)
+            d = self.descriptor()
+        if d["phase"] != "closed" or d["recovery"]["status"] != "reported_complete":
+            if not recover:
+                raise RuntimeError("inner recovery is not reported_complete")
+            self.transport.call([self.state["phonefarm"], "gray-layer", "session-recover",
+                                 "--session", str(self.out / "inner" / d["session_path"]),
+                                 "--serial", self.state["serial"], "--json"], timeout=300)
+            d = self.descriptor()
+        if d["phase"] != "closed" or d["recovery"]["status"] != "reported_complete":
+            raise RuntimeError("inner recovery is not reported_complete")
+        if self.child is not None:
+            self.child.wait(timeout=5)
+        self.state["inner_recovery"] = d["recovery"]
+        self.save()
+
+    def cleanup(self, recover=False):
+        """Restore originals only after inner recovery and target absence."""
+        with lock(self.out / "publisher.lock"):
+            self.state.update(accepting=False, phase="restoring")
+            self.save()
+        if self.state["restore_required"] or self.state["inner_launch"] != "not_started":
+            self.identity()
+        self.finish_inner(recover)
+        if self.state["pending_write"] is not None:
+            raise ValueError("unknown property write requires independent reconciliation; originals retained")
+        if self.state["restore_required"]:
+            self.identity()
+            names = self.shell("su -c 'ps -A -o NAME'").splitlines()
+            if not names or names[0].strip() != "NAME" or any(len(n.split()) != 1 for n in names[1:]):
+                raise ValueError("invalid target process readback")
+            package = self.state["package"]
+            if any(n.strip() == package or n.strip().startswith(package + ":") for n in names[1:]):
+                raise ValueError("target is still alive; originals retained")
+            for name in PROPERTIES:
+                if name in self.state["restored"]:
+                    if self.property(name) != self.state["originals"][name]:
+                        raise ValueError("restored property changed outside this probe")
+                else:
+                    self.write_property(name, self.state["originals"][name], "restore")
+                    self.state["restored"].append(name)
+                    self.save()
+        self.state.update(restore_required=False, phase="closed", recovery_status="reported_complete")
+        self.save()
+
+    def run(self, recover=False):
+        """Preserve failures separately from cleanup success."""
+        if self.state["phase"] == "closed":
+            return 0
+        if recover and self.state["pending_write"] is not None:
+            self.state.update(phase="recovery_required", accepting=False, recovery_status="required")
+            self.state["failures"].append({
+                "at": time.time(),
+                "error": "unknown property write; independent reconciliation required, no replay",
+            })
+            self.save()
+            return 2
+        failed = False
+        try:
+            if recover:
+                self.identity()
+            else:
+                self.prepare()
+                if not self.cancelled and time.monotonic() < self.deadline:
+                    self.start_inner()
+                    self.serve()
+        except Exception as error:  # noqa: BLE001 - Preserve all failures before owned cleanup.
+            failed = True
+            self.state["failures"].append({"at": time.time(), "error": str(error)})
+            self.save()
+        try:
+            self.cleanup(recover=recover)
+        except Exception as error:  # noqa: BLE001 - Retain recovery obligations on any failure.
+            failed = True
+            self.state.update(phase="recovery_required", accepting=False, recovery_status="required")
+            self.state["failures"].append({"at": time.time(), "error": str(error)})
+            self.save()
+        for path in (self.out / "requests").glob("*.json"):
+            request = read_json(path)
+            if (self.out / "started" / path.name).exists():
+                done = request["action"] == "stop" and self.state["phase"] == "closed"
+                self.result(request, "completed" if done else "unknown")
+            else:
+                self.result(request, "not_executed")
+        return 2 if failed else 0
+
+
+def initialize(args):
+    """Create a new output context and freeze caller-selected candidate bytes."""
+    out = Path(args.out).absolute()
+    data = read_bytes(Path(args.so), 128 * 1024 * 1024)
+    if not data:
+        raise ValueError("custom SO is empty")
+    receipt = read_bytes(Path(args.candidate_receipt)) if args.candidate_receipt else None
+    out.mkdir(parents=True, exist_ok=False)
+    out = out.resolve()
+    for name in ("requests", "started", "results", "commands"):
+        (out / name).mkdir()
+    atomic_bytes(out / "candidate.so", data)
+    if receipt is not None:
+        atomic_bytes(out / "candidate-receipt.json", receipt)
+    value = {"schema": SCHEMA, "out": str(out), "serial": args.serial,
+             "expected_physical_serial": args.expected_physical_serial, "physical_serial": None,
+             "boot_id": None, "transport": args.transport, "adb_server_socket": args.adb_server_socket,
+             "package": args.package, "duration": args.duration, "phonefarm": args.phonefarm,
+             "so_source": str(Path(args.so).absolute()), "so_sha256": hashlib.sha256(data).hexdigest(),
+             "candidate_receipt_source": str(Path(args.candidate_receipt).absolute()) if receipt is not None else None,
+             "candidate_receipt_sha256": hashlib.sha256(receipt).hexdigest() if receipt is not None else None,
+             "phase": "new", "accepting": False, "originals": {}, "pending_write": None,
+             "restore_required": False, "restored": [], "inner_launch": "not_started", "inner_id": None,
+             "inner_recovery": None, "stop_request": None, "failures": [], "created_at": time.time(),
+             "recovery_status": "not_started", "evidence_scope": "experimental_property_lifecycle",
+             "game_state_restored": False, "device_qualification": "not_claimed"}
+    durable(out / "probe.json", value)
+    return out
+
+
+def parser():
+    """Build the small experimental command interface."""
+    cli = argparse.ArgumentParser(description=__doc__)
+    sub = cli.add_subparsers(dest="command", required=True)
+    start = sub.add_parser("start")
+    start.add_argument("--serial", required=True)
+    start.add_argument("--expected-physical-serial", required=True)
+    start.add_argument("--transport", choices=("usb", "wireless"), required=True)
+    start.add_argument("--adb-server-socket", default=os.environ.get("ADB_SERVER_SOCKET", "tcp:127.0.0.1:5037"))
+    start.add_argument("--so", required=True)
+    start.add_argument("--candidate-receipt")
+    start.add_argument("--duration", type=int, choices=range(1, 601), required=True, metavar="1..600")
+    start.add_argument("--package", default="com.miHoYo.Yuanshen")
+    start.add_argument("--phonefarm", default=os.environ.get("PHONEFARM_BIN", "phonefarm"))
+    recovery = sub.add_parser("recover")
+    for item in (start, recovery):
+        item.add_argument("--out", required=True)
+        item.add_argument("--leased", action="store_true", help=argparse.SUPPRESS)
+    request = sub.add_parser("publish")
+    request.add_argument("--out", required=True)
+    request.add_argument("--request-id", required=True)
+    request.add_argument("--action", choices=("enable", "disable", "stop"), required=True)
+    status = sub.add_parser("status")
+    status.add_argument("--out", required=True)
+    return cli
+
+
+def main(argv=None):
+    """Reexec owners under phonefarm lease; publishers stay entirely host-only."""
+    argv = list(sys.argv[1:] if argv is None else argv)
+    args = parser().parse_args(argv)
+    out = Path(args.out).resolve()
+    try:
+        if args.command == "publish":
+            print(json.dumps(publish(out, args.request_id, args.action)))
+            return 0
+        if args.command == "status":
+            print(json.dumps(load_state(out)))
+            return 0
+        if args.command == "start":
+            if not args.serial or not args.expected_physical_serial:
+                raise ValueError("explicit nonempty serials required")
+            if args.transport == "usb" and args.serial != args.expected_physical_serial:
+                raise ValueError("USB transport requires the expected physical serial as its explicit serial")
+            if not re.fullmatch(r"[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)+", args.package):
+                raise ValueError("invalid package")
+            phonefarm, serial = args.phonefarm, args.serial
+        else:
+            state = load_state(out)
+            phonefarm, serial = state["phonefarm"], state["serial"]
+        if not args.leased:
+            executable = shutil.which(phonefarm)
+            if executable is None:
+                raise ValueError("phonefarm executable not found")
+            for fd in os.environ.get("PF_LOCK_FDS", "").split(","):
+                if fd:
+                    os.set_inheritable(int(fd), True)
+            os.execvpe(executable, [executable, "lease", "--serial", serial, "--",
+                       sys.executable, str(Path(__file__).resolve()), *argv, "--leased"], os.environ)
+        inherited_fds(serial)
+        if args.command == "start":
+            args.phonefarm = shutil.which(phonefarm) or phonefarm
+            out = initialize(args)
+        with lock(out / "owner.lock", blocking=False):
+            probe = Probe(out)
+            prior = {}
+            def stop(_signum, _frame):
+                probe.cancelled = True
+            try:
+                for signum in (signal.SIGINT, signal.SIGTERM):
+                    prior[signum] = signal.signal(signum, stop)
+                code = probe.run(recover=args.command == "recover")
+            finally:
+                for signum, handler in prior.items():
+                    signal.signal(signum, handler)
+            print(json.dumps(probe.state))
+            return code
+    except (OSError, ValueError, KeyError, RuntimeError) as error:
+        print(json.dumps({"status": "error", "error": str(error), "out": str(out)}), file=sys.stderr)
+        return 2
+
+
+if __name__ == "__main__":
+    sys.exit(main())
