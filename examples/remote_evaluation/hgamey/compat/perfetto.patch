+class ArtifactHTTPTests(unittest.TestCase):
+    """Serve only checksum-bound completed evidence through the local executor."""
+
+    def setUp(self):
+        """Start a loopback handler with no queue or phone access."""
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.jobs = Path(temporary.name)
+        self.key = 'a' * 32
+        self.evidence = self.jobs / self.key / 'evidence'
+        self.evidence.mkdir(parents=True)
+        self.content = b'synthetic HTTP transport fixture'
+        self.file = self.evidence / 'trace.pftrace'
+        self.file.write_bytes(self.content)
+        self.digest = hashlib.sha256(self.content).hexdigest()
+        self.result = self.jobs / self.key / 'result.json'
+        app.write_json(self.result, {'artifacts': [{'name': 'trace.pftrace', 'size': len(self.content), 'sha256': self.digest}]})
+        engine = SimpleNamespace(jobs=self.jobs, get=lambda key: {'id': key})
+        self.server = app.ThreadingHTTPServer(('127.0.0.1', 0), app.make_handler(engine))
+        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
+        self.thread.start()
+        self.addCleanup(self.server.server_close)
+        self.addCleanup(self.server.shutdown)
+        self.url = f'http://127.0.0.1:{self.server.server_port}/v1/jobs/{self.key}/artifacts/{self.digest}'
+
+    def test_raw_bytes_are_returned_without_json_encoding(self):
+        """Keep original trace bytes independent of the report JSON."""
+        with urllib.request.urlopen(self.url) as response:
+            self.assertEqual(response.read(), self.content)
+            self.assertEqual(response.headers['Content-Type'], 'application/octet-stream')
+
+    def test_changed_evidence_is_rejected(self):
+        """Do not serve corrupted bytes under their previous checksum."""
+        self.file.write_bytes(b'changed')
+        with self.assertRaises(urllib.error.HTTPError) as error:
+            urllib.request.urlopen(self.url)
+        self.assertEqual(error.exception.code, 409)
+
+    def test_manifest_cannot_escape_job_evidence(self):
+        """An untrusted relative path cannot expose another executor file."""
+        app.write_json(self.result, {'artifacts': [{'name': '../../outside', 'size': len(self.content), 'sha256': self.digest}]})
+        with self.assertRaises(urllib.error.HTTPError) as error:
