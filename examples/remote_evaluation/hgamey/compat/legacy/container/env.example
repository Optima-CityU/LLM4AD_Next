# Platform connection. Copy this file to .env and fill the required values.
LLM4AD_SERVER_URL=https://test.llm4ad-next.cn
LLM4AD_GATEWAY_NAME=genshin-phone
LLM4AD_ALLOWED_USER_IDS=YOUR_PLATFORM_USER_UUID

# Multiple wireless devices. Leave HOST/ID empty to enable every entry.
# Port is the connect port, not Android's temporary pairing port.
# HGAMEY_DEVICES_JSON='[{"id":"phone-a","host":"192.168.1.101","port":37123,"expected_serial":"SERIAL_A","device_profile":"Mali-driver-v1"},{"id":"phone-b","host":"192.168.1.102","port":41235,"expected_serial":"SERIAL_B","device_profile":"Mali-driver-v2"}]'
HGAMEY_DEVICES_JSON=

# Alternatively use config/devices.json or the single-device fields below.
# ID optionally selects one enabled device; empty ID enables all configured devices.
HGAMEY_DEVICE_ID=
HGAMEY_DEVICE_HOST=
HGAMEY_DEVICE_PORT=5555
HGAMEY_DEVICE_SERIAL=
HGAMEY_DEVICE_PROFILE=YOUR_GPU_DRIVER_ANDROID_BUILD_V1
# Optional existing authorized private key; empty uses persistent Android identity.
ADB_IDENTITY_FILE=

# Private reference frames are mounted read-only; state/artifacts use runtime/.
HGAMEY_REFERENCE_PATH=/inputs/genshin
HGAMEY_PROFILE_VERSION=genshin-sr-v1
HGAMEY_EVAL_SECONDS=5
HGAMEY_EVAL_ROUNDS=8
HGAMEY_ELITE_EVAL_SECONDS=5
HGAMEY_ELITE_EVAL_ROUNDS=16
HGAMEY_COOL_C=50
HGAMEY_GPU_LEVEL=
HGAMEY_BUDGET_MS=10
HGAMEY_QUALITY_BASELINE_DB=30
HGAMEY_REQUIRE_DISCHARGING=false
HGAMEY_ALLOW_MISSING_POWER=true
HGAMEY_PAUSE_FOREGROUND=false
HGAMEY_PACKAGE=com.miHoYo.Yuanshen

# A distinct, durable readiness-only baseline test precedes registration.
HGAMEY_STARTUP_CHECK=true
HGAMEY_STARTUP_CHECK_SECONDS=1
HGAMEY_STARTUP_CHECK_ROUNDS=2
HGAMEY_STARTUP_CHECK_TIMEOUT=1800
HGAMEY_HEALTH_START_PERIOD=30m
HGAMEY_STOP_GRACE_PERIOD=35m

# Clean completed local evidence only after uploads, final acknowledgement and restoration.
# The default removes bulk data on the next pass. Set hours > 0 to retain it for debugging.
HGAMEY_CLEANUP_ENABLED=true
HGAMEY_CLEANUP_INTERVAL_SECONDS=30
HGAMEY_LOCAL_EVIDENCE_KEEP_HOURS=0

# Optional build-time mirrors; no software installation occurs during startup.
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
PIP_INDEX_URL=https://pypi.org/simple
ADB_PLATFORM_TOOLS_URL=https://dl.google.com/android/repository/platform-tools_r36.0.2-linux.zip
ADB_PLATFORM_TOOLS_SHA256=3afdea91441815ab41254193df0343d92c1b1c0d0237165c3a345c8af8891c31

# Optional host mounts and private local ports. Share phonefarm state for a shared phone.
HGAMEY_CONFIG_DIR=./config
HGAMEY_INPUTS_DIR=./inputs
HGAMEY_STATE_DIR=./runtime/executor
HGAMEY_PHONEFARM_DIR=./runtime/phonefarm
EXECUTOR_PORT=8767
ANDROID_ADB_SERVER_PORT=5039
HGAMEY_DEVICE_LABEL=
HGAMEY_P_THRESHOLD=0.01
# A confirmed gain must also reach this percentage; values below 1 are rejected.
HGAMEY_MIN_OPERATOR_IMPROVEMENT_PCT=1
HGAMEY_COMPILE_TIMEOUT=60
HGAMEY_POLL_INTERVAL=2

# Optional real-game validation after each valid operator measurement.
# Copy game-check.json to config/game-check.json and adjust the scene.
# Requires the actual Android NDK at the read-only mount; no model API is used.
HGAMEY_GAME_CHECK_CONFIG=

# Optional build-time mirror for the SDK-pinned, checksum-verified processor.
TRACE_PROCESSOR_URL=
HGAMEY_NDK_DIR=./toolchain/ndk-r27d
